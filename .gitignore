.env
__pycache__/
*.pyc
.ipynb_checkpoints/
checkpoints/
*.egg-info/
.venv/
venv/
node_modules/
.pytest_cache/
.ruff_cache/

# data/ và models/ do DVC quản lý — `dvc add`/`dvc repro` tự sinh entry .gitignore
# tương ứng, KHÔNG thêm tay (SPEC mục 11.4). Chỉ giữ .gitkeep để git thấy thư mục.
# Model/checkpoint tuyệt đối không commit trần:
*.onnx
*.pt
*.pth
!data/splits/.gitkeep
.dvc/cache
.dvc/tmp

# Keep large datasets out of Git while tracking DVC metadata.
data/raw/**
!data/raw/**/
!data/raw/**/*.dvc
data/processed/**
!data/processed/**/
!data/processed/**/*.dvc
!data/raw/.gitkeep
!data/processed/.gitkeep
